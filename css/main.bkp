        background: rgba(255, 255, 255, 0.2); 
        backdrop-filter: blur(1rem); 
        -webkit-backdrop-filter: blur(0.8rem); /* Soporte para Safari */
        border-radius: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.3); /* Borde brillante simulando reflejo */
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        /* Espaciado interno básico */
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: space-evenly;
